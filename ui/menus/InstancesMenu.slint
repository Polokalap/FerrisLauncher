import { IconDisplay, IconSet, Icon } from "@lucide";
import "../fonts/Poppins.ttf";
import { Button, ScrollView, VerticalBox } from "std-widgets.slint";
import { Instance } from "Instance.slint";
import { SidebarState, InstanceData, SidebarMenu } from "../state.slint";

export component InstancesMenu {
    in-out property <int> columns: 4;
    in-out property <[InstanceData]> instances;
    width: 100%;
    height: 100%;

    ScrollView {
        padding-left: 20px;
        padding-top: 15px;

        HorizontalLayout {
            spacing: SidebarState.is_open ? 20px : 15px;

            VerticalLayout {
                cache-rendering-hint: true;
                width: 100%;
                height: 100%;
                padding: 3px;
                GridLayout {
                    spacing: 20px;
                    cache-rendering-hint: true;

                    for instance[i] in instances: Instance {
                        name: instance.name;
                        version: instance.version;

                        icon: instance.icon == "box" ? IconSet.Box :
                              instance.icon == "package" ? IconSet.Package :
                              IconSet.Box;

                        row: Math.floor(i / columns);
                        col: Math.mod(i, columns);
                    }

                    Rectangle {
                        width: SidebarState.is_open ? 218px : 256px;
                        height: SidebarState.is_open ? 130px : 146px;
                        row: Math.floor(instances.length / columns);
                        col: Math.mod(instances.length, columns);
                        border-radius: 15px;
                        border-color: #33ff55aa;
                        background: touch-area.has-hover ? #33ff5588 : #33ff5555;
                        animate background {
                            duration: 200ms;
                            easing: ease-in-out;
                        }
                        border-width: 2px;
                        clip: true;
                        touch-area := TouchArea {
                            mouse-cursor: pointer;
                        }
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: center;
                                IconDisplay {
                                    icon: IconSet.Plus;
                                    stroke: #33ff55aa;
                                    stroke-width: 2;
                                    size: 96px;
                                }
                            }
                        }
                    }

                }

            }

        }

    }

}