import { IconDisplay, IconSet, Icon } from "@lucide";
import "../fonts/Poppins.ttf";
import { Button } from "std-widgets.slint";
import { Instance } from "Instance.slint";
import { SidebarState, InstanceData } from "../state.slint";

export component InstancesMenu {
    in-out property <int> columns: 4;
    in-out property <[InstanceData]> instances;
    width: 100%;
    height: 100%;

    VerticalLayout {
        alignment: start;
        padding-left: SidebarState.is_open ? 165px : 25px;
        padding-top: 15px;
        animate padding-left {
            duration: 100ms;
            easing: ease-in-out;
        }

        HorizontalLayout {
            alignment: start;
            spacing: SidebarState.is_open ? 20px : 15px;

            GridLayout {
                spacing: 20px;

                for instance[i] in instances: Instance {
                    name: instance.name;
                    version: instance.version;

                    icon: instance.icon == "Box" ? IconSet.Box :
                          instance.icon == "Package" ? IconSet.Package :
                          IconSet.Box;

                    row: Math.floor(i / columns);
                    col: Math.mod(i, columns);
                }

            }

        }

    }

}